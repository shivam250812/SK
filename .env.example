# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave empty to try the built-in list of Live models in order.
GEMINI_LIVE_MODEL=

# Optional. Default voice. One of: Sulafat, Aoede, Achernar, Leda, Vindemiatrix, Kore
GEMINI_VOICE=

PORT=3000

# Only for the Sarvam agent page (/sarvam.html). Key from the Samvaad dashboard,
# Settings > API Key. This is not the sk_ key used for Sarvam's model APIs.
SARVAM_AGENT_API_KEY=
# Only for sarvam_hello.py (Sarvam model APIs, sk_ key).
SARVAM_API_KEY=
# Optional. Default to the "Snapdeal Virtual KAM" agent's IDs set in server.js.
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
# Optional. If set, the agent's tool calls must send "Authorization: Bearer <this value>".
SARVAM_TOOL_TOKEN=
