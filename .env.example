# Required. The agent key from the Sarvam dashboard: Settings > API Key
# (indus.sarvam.ai/samvaad/settings/api-key). Not the sk_ key for Sarvam's model APIs.
SARVAM_AGENT_API_KEY=

# Optional. Point the page at a different agent. Defaults are in server.js.
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=

# Optional. If set, the agent's tool calls must send "Authorization: Bearer <this value>".
SARVAM_TOOL_TOKEN=

PORT=3000
